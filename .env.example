# PostgreSQL (used by docker/docker-compose.db.yml and docker/docker-compose.yml)
POSTGRES_DB=eshop
POSTGRES_USER=eshop
POSTGRES_PASSWORD=eshop

# App datasource (used by docker/docker-compose.yml)
DB_URL=jdbc:postgresql://db:5432/eshop
DB_USER=eshop
DB_PASSWORD=eshop

# JWT (used by docker/docker-compose.yml)
# Use a random secret of at least 32 bytes in production.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes-0123456789
JWT_EXPIRATION=3600

# Spring AI — set the key for the active profile (openai or gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Qdrant (RAG vector store, used with the `rag-qdrant` profile)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=

# Redis (Spring Cache backend, used by docker/docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
