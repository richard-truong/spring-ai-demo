{
  "info": {
    "_postman_id": "b1f0a4c2-6d3e-4a77-9c1e-2f5b8a0d4e11",
    "name": "EvShop",
    "description": "EvShop API — Spring Boot hexagonal e-commerce backend.\n\nEndpoints:\n- POST /api/v1/auth/register — create a customer account\n- POST /api/v1/auth/login — authenticate, returns JWT (auto-saved to {{token}})\n- POST /api/v1/orders — place an order (requires Bearer token)\n- POST /api/v1/suggest — AI product suggestion (public)\n\nRun folders in order: Auth -> Orders. The login request stores the JWT in the\ncollection variable `token`, which the Orders folder consumes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('email', `customer+${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('returns the created user', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(body.name).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"{{name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates a customer account. The pre-request script generates a unique\nemail so the request stays repeatable — a duplicate email returns 409 Conflict.\n\nPassword must be 8–72 characters."
          },
