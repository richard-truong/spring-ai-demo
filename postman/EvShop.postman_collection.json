    {
      "name": "AI",
      "item": [
        {
          "name": "Suggest Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a product suggestion', () => {",
                  "    pm.expect(body.name).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.price).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.description).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Matcha Latte\",\n  \"platform\": \"Instagram\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/suggest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "suggest"
              ]
            },
            "description": "Public endpoint. Asks the configured Spring AI chat model (openai profile\nby default, or gemini via `spring.profiles.active`) for a marketing suggestion\nfor a product name on a given platform.\n\nRequires OPENAI_API_KEY or GEMINI_API_KEY to be set — without it the model call\nfails and the request returns 500. The prompt template lives in\nsrc/main/resources/prompts/system.txt."
          },
